{
  "manifest_version": 3,
  "name": "Ticket Extractor",
  "version": "3.0.0",
  "description": "Extract ticket information from Pureservice and HubSpot with one click",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.pureservice.com/*",
    "https://*.hubspot.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
